{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウに許可する権限。ファイル選択ダイアログ、全画面の切替、イベントの送受信、自前のコマンドだけ。",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "allow-open-document",
    "allow-save-document",
    "allow-save-document-as",
    "allow-check-document",
    "allow-watch-document",
    "allow-write-draft",
    "allow-list-drafts",
    "allow-read-draft",
    "allow-delete-draft",
    "allow-load-session",
    "allow-save-session",
    "allow-open-folder",
    "allow-list-folder",
    "allow-create-file",
    "allow-create-folder",
    "allow-rename-entry",
    "allow-trash-entry",
    "allow-watch-folders",
    "allow-open-external-url",
    "allow-close-app",
    "allow-load-preferences",
    "allow-save-preferences",
    "allow-import-background-image",
    "allow-read-background-image",
    "allow-write-clipboard-text",
    "allow-load-plugin-permissions",
    "allow-save-plugin-permissions",
    "allow-set-logging",
    "allow-append-log"
  ]
}
