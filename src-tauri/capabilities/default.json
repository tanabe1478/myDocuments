{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウに許可する権限。ファイル選択ダイアログ、全画面の切替、自前のコマンドだけ。",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-emit",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "allow-open-document",
    "allow-save-document",
    "allow-save-document-as",
    "allow-load-preferences",
    "allow-save-preferences",
    "allow-import-background-image",
    "allow-read-background-image"
  ]
}
