{
  "seed": { "files": { "/docs/note.md": { "text": "一行目\n二行目" } }, "openPath": "/docs/note.md" },
  "steps": [
    { "press": "ControlOrMeta+o" },
    { "expect": { "testId": "doc-title", "equals": "note.md" } },
    { "click": ".cm-content" },
    { "press": "ControlOrMeta+End" },
    { "type": "（自分の追記）" },
    { "externalWrite": { "path": "/docs/note.md", "text": "一行目\n二行目（外部の追記）" } },
    { "expect": { "testId": "conflict-bar", "read": "attr:data-state", "equals": "conflict" }, "note": "未保存の変更があるときは本文に触れず、競合バーを出す" },
    { "expect": { "testId": "conflict-diff", "read": "visible", "equals": true } },
    { "expect": { "testId": "conflict-reload", "read": "visible", "equals": true } },
    { "expect": { "testId": "conflict-keep", "read": "visible", "equals": true }, "note": "3 つの選択肢" },
    { "expect": { "eval": "window.__mdeE2E.editor.getText()", "equals": "一行目\n二行目（自分の追記）" } },
    { "expect": { "testId": "conflict-bar", "read": "css:opacity", "equals": "1" }, "note": "出現のフェードが終わるまで待つ（途中で撮ると、バーが薄く写る）" },
    { "screenshot": "conflict-bar" },
    { "click": { "testId": "conflict-diff" } },
    { "expect": { "testId": "diff-dialog", "read": "visible", "equals": true } },
    { "expect": { "css": "[data-testid=diff-dialog] .cm-mergeView .cm-editor", "read": "count", "equals": 2 } },
    { "screenshot": "diff-dialog" },
    { "press": "Escape" },
    { "expect": { "testId": "diff-dialog", "read": "count", "equals": 0 } },
    { "click": { "testId": "conflict-keep" } },
    { "expect": { "eval": "window.__mdeE2E.backups.length", "equals": 0 }, "note": "選んだだけでは書かない" },
    { "press": "ControlOrMeta+s" },
    { "expect": { "testId": "unsaved-mark", "read": "count", "equals": 0 } },
    { "expect": { "testId": "toast", "contains": "バックアップ" } },
    { "expect": { "eval": "new TextDecoder().decode(Uint8Array.from(window.__mdeE2E.readFile('/docs/note.md')))", "equals": "一行目\n二行目（自分の追記）" } },
    { "observe": "after-keep-mine", "files": ["/docs/note.md"] },
    { "expect": { "eval": "window.__mdeE2E.readBackups().map((b) => new TextDecoder().decode(Uint8Array.from(b.bytes)))", "equals": ["一行目\n二行目（外部の追記）"] }, "note": "上書き前のディスクの版がバックアップされる" },
    { "type": "さらに" },
    { "externalWrite": { "path": "/docs/note.md", "text": "また外部の版" } },
    { "expect": { "testId": "conflict-bar", "read": "visible", "equals": true } },
    { "click": { "testId": "conflict-reload" } },
    { "expect": { "eval": "window.__mdeE2E.editor.getText()", "equals": "また外部の版" }, "note": "ディスクから読み直す" },
    { "expect": { "eval": "window.__mdeE2E.readDrafts().some((d) => d.text === '一行目\\n二行目（自分の追記）さらに')", "equals": true }, "note": "自分の本文は草稿へ退避される" },
    { "expect": { "testId": "toast", "contains": "草稿に退避しました" } },
    { "observe": "after-reload", "files": ["/docs/note.md"] }
  ]
}
