    },
    {
      "expect": {
        "role": "dialog",
        "name": "設定",
        "read": "visible",
        "equals": true
      }
    },
    {
      "check": {
        "panel": true,
        "role": "radio",
        "name": "リストの形に合わせる"
      }
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.savedPreferences.at(-1)?.listContinuation",
