      "press": "ControlOrMeta+End"
    },
    {
      "screenshot": "before-enter"
    },
    {
      "press": "Enter"
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.editor.getText()",
        "equals": "大規模処理\n- パッチ\n  - Batches\n  - 他にも\n\n\n\n- temperature について\n- "
      },
      "note": "既定（空行を入れない）: 空行は入らず、改行と記号だけが入る"
    },
    {
      "screenshot": "after-enter-tight"
    },
    {
      "type": "次の項目"
    },
    {
      "press": "ControlOrMeta+s"
    },
    {
      "expect": {
        "testId": "unsaved-mark",
        "read": "count",
        "equals": 0
      }
    },
    {
      "observe": "saved-tight",
      "files": [
        "/docs/list.md"
      ]
    },
    {
      "press": "ControlOrMeta+,"
    },
    {
      "expect": {
        "role": "dialog",
        "name": "設定",
        "read": "visible",
        "equals": true
      }
    },
    {
      "expect": {
        "eval": "document.querySelector('input[name=list-continuation]:checked').value",
        "equals": "tight"
      },
      "note": "設定画面の「編集」の節の既定は「空行を入れない」"
    },
    {
      "eval": "document.querySelector('[data-testid=settings-editing]').scrollIntoView({ block: 'end' })"
    },
    {
      "expect": {
        "testId": "settings-editing",
        "read": "visible",
        "equals": true
      }
    },
    {
      "screenshot": "settings-editing-light"
    },
    {
      "check": {
        "panel": true,
        "role": "radio",
        "name": "リストの形に合わせる"
      }
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.savedPreferences.at(-1)?.listContinuation",
        "equals": "preserve",
        "timeout": 4000
      },
      "note": "debounce の後に bridge へ保存される"
    },
    {
      "press": "Escape"
    },
    {
      "expect": {
        "role": "dialog",
        "name": "設定",
        "read": "count",
        "equals": 0
