{
  "seed": {
    "files": {
      "/docs/list.md": {
        "text": "大規模処理\n- パッチ\n  - Batches\n  - 他にも\n\n\n\n- temperature について"
      }
    },
    "openPath": "/docs/list.md",
    "preferences": {
      "theme": "light",
      "autoHideChrome": false
