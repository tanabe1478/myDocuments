        "equals": "true"
      }
    },
    {
      "expect": {
        "eval": "document.documentElement.getAttribute('data-theme')",
        "equals": "dark"
      }
    },
    {
      "screenshot": "01-dark-tree"
    },
    {
      "click": {
        "css": "[data-testid=file-tree] [role=treeitem][aria-label='a.md'] > .tree-row"
