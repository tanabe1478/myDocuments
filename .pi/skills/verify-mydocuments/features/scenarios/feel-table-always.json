{
  "seed": {
    "files": {
      "/docs/table.md": {
        "text": "# 表の見本\n\n前の段落です。\n\n| 果物 | 個数 | 備考 |\n|:-----|-----:|:----:|\n| りんご | 3 | **赤い** と `code` |\n| みかん |  | [リンク](https://example.com) |\n| a \\| b | 1 | ~~売り切れ~~ *残り少し* |\n\n後ろの段落です。\n\n- 箇条書き\n- もう一つ"
      }
    },
    "openPath": "/docs/table.md",
    "preferences": {
      "theme": "light",
      "autoHideChrome": false,
      "markupDisplay": "always"
    }
  },
  "steps": [
    {
      "press": "ControlOrMeta+o"
    },
    {
      "expect": {
        "testId": "doc-title",
        "equals": "table.md"
      }
    },
    {
      "click": {
        "css": ".cm-content",
        "position": {
          "x": 5,
          "y": 5
        }
      }
    },
    {
      "press": "ControlOrMeta+Home"
    },
    {
      "eval": "window.__sel = { count: 0, head: 0 }; window.__mdeE2E.editor.onSelectionChange((s) => (window.__sel = { count: window.__sel.count + 1, head: s.head })); true"
    },
    {
      "expect": {
        "css": ".cm-md-table",
        "read": "count",
        "equals": 0,
        "note": "設定「常に表示」では、表は原文のまま"
      }
    },
    {
      "expect": {
        "css": ".cm-content",
        "read": "text",
        "contains": "|:-----|-----:|:----:|",
        "note": "区切りの行が見える"
      }
    },
    {
      "press": "ArrowDown",
      "times": 4
    },
    {
      "press": "Home"
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.editor.getSelection().head",
        "equals": 17,
        "note": "表の 1 行目の頭"
      }
    },
    {
      "press": "Tab"
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.editor.getSelection().head",
        "equals": 19,
        "note": "「常に表示」でも、Tab で最初のセルの頭へ"
      }
    },
    {
      "press": "Tab"
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.editor.getSelection().head",
        "equals": 24,
        "note": "次のセル"
      }
    },
    {
      "press": "Tab",
      "times": 2
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.editor.getSelection().head",
        "equals": 59,
        "note": "区切りの行を飛ばして、次の行の最初のセル"
      }
    },
    {
      "expect": {
        "eval": "window.__mdeE2E.editor.getText().length",
        "equals": 184
      }
    },
    {
      "screenshot": "table-always"
    }
  ]
}
