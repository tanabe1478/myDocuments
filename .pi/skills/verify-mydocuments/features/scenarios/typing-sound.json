{
  "seed": {
    "files": { "/docs/sound.md": { "text": "- 一つ目" } },
    "openPath": "/docs/sound.md",
    "preferences": { "theme": "light", "autoHideChrome": false }
  },
  "steps": [
    { "press": "ControlOrMeta+o" },
    { "expect": { "testId": "doc-title", "equals": "sound.md" } },
    { "click": ".cm-content" },
    { "press": "ControlOrMeta+End" },
    { "press": "a" },
    { "press": "Enter" },
    { "expect": { "eval": "window.__mdeE2ETypingSound", "equals": { "fetches": 0, "fetchedTimbres": [], "contexts": 0, "decoded": 0, "decodedTimbres": [], "decodedOffsets": {}, "decodedCount": 0, "requests": [] } }, "note": "既定はオフ: 素材の fetch も AudioContext の生成も音の要求もない" },
    { "press": "ControlOrMeta+," },
    { "expect": { "panel": true, "role": "checkbox", "name": "タイピング音", "read": "visible", "equals": true } },
    { "expect": { "eval": "document.querySelector('[data-testid=settings-sound]').querySelector('input[name=typing-sound-volume]:checked').value", "equals": "medium" }, "note": "「音」の節の音量は、既定が中" },
    { "expect": { "eval": "(document.querySelector('[data-testid=settings-sound]').scrollIntoView({ block: 'end' }), true)", "equals": true }, "note": "撮影のため、「音」の節が見える位置までスクロールする" },
    { "screenshot": "settings-typing-sound-off" },
    { "check": { "panel": true, "role": "checkbox", "name": "タイピング音" } },
    { "check": { "panel": true, "role": "radio", "name": "大" } },
    { "expect": { "eval": "(({ typingSound, typingSoundVolume }) => ({ typingSound, typingSoundVolume }))(window.__mdeE2E.savedPreferences.at(-1) || {})", "equals": { "typingSound": true, "typingSoundVolume": "high" }, "timeout": 4000 }, "note": "debounce の後に bridge へ保存される" },
    { "expect": { "eval": "window.__mdeE2ETypingSound.fetches", "equals": 1 }, "note": "オンにすると素材の読み込みが始まる（AudioContext はまだ）" },
    { "expect": { "eval": "window.__mdeE2ETypingSound.contexts", "equals": 0 } },
    { "press": "Escape" },
    { "click": ".cm-content" },
    { "press": "ControlOrMeta+End" },
    { "press": "x" },
    { "expect": { "eval": "window.__mdeE2ETypingSound.decoded", "equals": 1, "timeout": 4000 }, "note": "最初のキーが AudioContext を作り、10 個をデコードする（このキーは鳴らない）" },
    { "expect": { "eval": "window.__mdeE2ETypingSound.decodedCount", "equals": 10 } },
    { "expect": { "eval": "window.__mdeE2ETypingSound.requests.length", "equals": 0 } },
    { "wait": 60 },
    { "press": "b" },
    { "expect": { "eval": "window.__mdeE2ETypingSound.requests.length", "equals": 1 }, "note": "キー 1 回につき音の要求が 1 回" },
    { "press": "Shift" },
    { "press": "ArrowLeft" },
    { "press": "Escape" },
    { "press": "ControlOrMeta+a" },
    { "wait": 60 },
    { "expect": { "eval": "window.__mdeE2ETypingSound.requests.length", "equals": 1 }, "note": "修飾キーだけ、移動、Escape、Cmd/Ctrl のショートカットは要求を出さない" },
    { "press": "ControlOrMeta+End" },
    { "wait": 60 },
    { "press": "Enter" },
    { "expect": { "eval": "(() => { const r = window.__mdeE2ETypingSound.requests; return [r.length, r.at(-1).kind, r.at(-1).rate > 0.7 && r.at(-1).rate < 0.9, r.at(-1).gain > 0.9]; })()", "equals": [2, "enter", true, true] }, "note": "Enter は低い音（再生速度 0.8 前後）、音量は大（gain 1.0 の ±10%）" },
    { "expect": { "eval": "window.__mdeE2E.editor.getText()", "equals": "- 一つ目a\n- xb\n- " }, "note": "入力した文字と、Enter でのリストの継続は変わらない" },
    { "reload": true },
    { "press": "ControlOrMeta+," },
    { "expect": { "panel": true, "role": "checkbox", "name": "タイピング音", "read": "visible", "equals": true } },
    { "expect": { "eval": "document.querySelector('[data-testid=settings-sound]').querySelector('input[name=typing-sound-volume]:checked').value", "equals": "high" }, "note": "再読み込み後も、音量が残る" },
    { "expect": { "eval": "window.__mdeE2ETypingSound.fetches", "equals": 1 }, "note": "オンで起動したので、素材の読み込みが始まっている" },
    { "expect": { "eval": "(document.querySelector('[data-testid=settings-sound]').scrollIntoView({ block: 'end' }), true)", "equals": true } },
    { "screenshot": "settings-typing-sound-on" }
  ]
}
